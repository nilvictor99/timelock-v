# TimeLock-v - plantilla de configuración local.
# Copia este archivo como ".env" (los scripts lo hacen automáticamente) y ajusta lo que necesites.
# IMPORTANTE: este archivo debe contener solo líneas "VARIABLE=valor" para que los
# scripts puedan cargarlo de forma segura sin ejecutar su contenido.

# --- Aplicación ---
NEXT_PUBLIC_APP_NAME="TimeLock-v"
# Puerto local de la aplicación Next.js (start.sh / start-docker.sh buscan el siguiente libre si está ocupado).
APP_PORT="3000"
# Puerto local expuesto de PostgreSQL en Docker (start-docker.sh).
POSTGRES_PORT="5432"
# Puerto local expuesto de pgAdmin en Docker (start-docker.sh).
PGADMIN_PORT="5050"

# --- Base de datos (arranque local sin Docker) ---
DATABASE_URL="postgresql://timelock:timelock@localhost:5432/timelock?schema=public"

# --- IA (opcional, solo servidor; nunca exponer con NEXT_PUBLIC_*) ---
# Proveedores válidos: openai | openrouter | nvidia | anthropic | gemini | ollama | custom | opencode
AI_PROVIDER=""
AI_BASE_URL=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_API_KEY=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_BASE_URL=""
# URLs base por defecto de cada proveedor (casi nunca cambian; el código las usa
# cuando AI_BASE_URL está vacía y no hay una URL personalizada por usuario).
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Proveedor adicional: OpenCode Zen (compatible con OpenAI).
# Clave en https://opencode.ai/auth y modelos en https://opencode.ai/docs/zen/
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_API_KEY=""
