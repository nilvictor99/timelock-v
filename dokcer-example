services:
    app:
        build:
            context: '.'
            dockerfile: Dockerfile
        image: 'timelock-v-app'
        container_name: '${COMPOSE_PROJECT_NAME:-timelock}-app'
        extra_hosts:
            - 'host.docker.internal:host-gateway'
        ports:
            - '${APP_PORT:-3000}:3000'
        environment:
            NODE_ENV: '${NODE_ENV:-production}'
            NEXT_PUBLIC_APP_NAME: '${NEXT_PUBLIC_APP_NAME:-TimeLock-v}'
        networks:
            - timelock
        depends_on:
            postgres:
                condition: service_healthy

    postgres:
        image: 'postgres:16-alpine'
        container_name: '${COMPOSE_PROJECT_NAME:-timelock}-postgres'
        ports:
            - '${FORWARD_DB_PORT:-5432}:5432'
        environment:
            POSTGRES_DB: '${DB_DATABASE:-timelock}'
            POSTGRES_USER: '${DB_USERNAME:-timelock}'
            POSTGRES_PASSWORD: '${DB_PASSWORD:-timelock}'
        volumes:
            - 'timelock-postgres:/var/lib/postgresql/data'
        networks:
            - timelock
        healthcheck:
            test:
                - CMD
                - pg_isready
                - '-q'
                - '-d'
                - '${DB_DATABASE:-timelock}'
                - '-U'
                - '${DB_USERNAME:-timelock}'
            interval: 5s
            timeout: 5s
            retries: 10

    pgadmin:
        image: 'dpage/pgadmin4:9.0'
        container_name: '${COMPOSE_PROJECT_NAME:-timelock}-pgadmin'
        environment:
            PGADMIN_DEFAULT_EMAIL: 'admin@admin.com'
            PGADMIN_DEFAULT_PASSWORD: 'admin'
        ports:
            - '${PGADMIN_PORT:-5050}:80'
        depends_on:
            - postgres
        networks:
            - timelock

networks:
    timelock:
        driver: bridge

volumes:
    timelock-postgres:
        driver: local