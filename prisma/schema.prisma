generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityStatus {
  PLANNED
  ACTIVE
  COMPLETED
  MISSED
  SKIPPED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum OperationMode {
  SYNCHRONOUS
  FREE
}

model User {
  id                   String       @id @default(cuid())
  name                 String       @default("Mi espacio")
  email                String?      @unique
  passwordHash         String?
  avatarUrl            String?
  country              String?
  city                 String?
  onboardingCompleted  Boolean      @default(false)
  timezone             String       @default("UTC")
  operationMode        OperationMode @default(SYNCHRONOUS)
  birthDate            DateTime?
  genderIdentity       String?
  fitnessLevel         String?
  physicalLimitations  String?
  exerciseIntensity    String?
  skillsWithExperience Json?
  hobbies              Json?
  sports               Json?
  creativeActivities   Json?
  learningInterests    Json?
  preferredActivityTypes Json?
  preferredDuration    String?
  preferredTimesOfDay  Json?
  soloGroupPreference  String?
  energyLevel          String?
  indoorOutdoorPreference String?
  activityBudget       String?
  workStudyStart       String?
  workStudyEnd         String?
  freeDays             Json?
  occupation           String?
  bio                  String?
  interests            String?
  goals                String?
  workHours            String?
  dailyAvailableMinutes Int?
  resourcesAccess      Json?
  mainGoals            Json?
  shortTermGoals       String?
  motivationLevel      Int?
  theme                Theme        @default(SYSTEM)
  language             String       @default("es")
  timezoneOverride     String?
  timeFormat           String       @default("24")
  measurementUnit      String       @default("METRIC")
  notificationsEnabled Boolean      @default(true)
  notificationTypes    Json?
  notificationFrequency String      @default("ALL")
  quietHoursStart      String?
  quietHoursEnd        String?
  voiceEnabled         Boolean      @default(false)
  notifyVolume         Int          @default(70)
  notificationVoice    String?
  generationPersonalization Int     @default(70)
  avoidRecentActivities Boolean     @default(false)
  recentActivitiesWindow Int        @default(7)
  includeCompletedHistory Boolean    @default(true)
  profileVisibility    String       @default("PRIVATE")
  aiProvider           String?
  aiModel              String?
  aiBaseUrl            String?
  aiTemperature        Float        @default(0.7)
  aiMaxTokens          Int          @default(500)
  pauseActive          Boolean      @default(false)
  pauseReason          String?
  pauseStartsAt         DateTime?
  pauseEndsAt           DateTime?
  points               Int          @default(0)
  currentStreak        Int          @default(0)
  bestStreak           Int          @default(0)
  createdAt            DateTime     @default(now())
  lastAccessAt         DateTime?
  updatedAt            DateTime     @updatedAt
  activities   Activity[]
  categories   Category[]
  rewards      Reward[]
  sessions     Session[]
  qrTokens     QrLoginToken[]
  suggestions  Suggestion[]
}

model Category {
  id          String     @id @default(cuid())
  userId      String
  name        String
  color       String     @default("#111111")
  pointsPerHour Int      @default(5)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities  Activity[]
  @@unique([userId, name])
}

model Activity {
  id          String         @id @default(cuid())
  userId      String
  categoryId  String?
  title       String
  description String?
  date        DateTime
  startAt     DateTime
  endAt       DateTime
  status      ActivityStatus @default(PLANNED)
  points      Int            @default(0)
  isFree      Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([userId, date])
  @@index([userId, startAt])
}

model Reward {
  id          String   @id @default(cuid())
  userId      String
  title       String
  cost        Int
  description String?
  redeemedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model QrLoginToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Suggestion {
  id            String   @id @default(cuid())
  userId        String
  generationId  String
  title         String
  category      String
  duration      Int
  reason        String
  points        Int
  suggestedTime String?
  source        String   @default("rule")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, generationId])
}
